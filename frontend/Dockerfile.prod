# 生产构建：VITE_* 在 build 阶段烘焙进静态产物，再交给 nginx 托管。
# 用法见 docker-compose.prod.yml（通过 build args 注入公网 IP 地址）。

FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Vite 读取 VITE_ 前缀的环境变量并在构建时写死进 bundle
ARG VITE_API_URL
ARG VITE_WS_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# SPA 路由回退：未知路径交给 index.html，避免刷新 /reviews/xxx 404
RUN printf 'server {\n  listen 80;\n  location / {\n    root /usr/share/nginx/html;\n    try_files $uri $uri/ /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
