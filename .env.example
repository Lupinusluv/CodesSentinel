# ── LLM ──────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── 数据库 ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://codessentinel:codessentinel@localhost:5432/codessentinel

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Git 平台 ──────────────────────────────────────
# GitHub Token：拉 PR diff + 写 commit status + 发 PR 评论。
# 经典 PAT：公开仓库勾 public_repo；私有仓库勾 repo。
GITHUB_TOKEN=your_github_personal_access_token
# Webhook 验签密钥（需与 GitHub Webhook 配置里的 Secret 一致）
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITLAB_WEBHOOK_SECRET=your_gitlab_webhook_secret
GITEE_WEBHOOK_SECRET=your_gitee_webhook_secret

# ── 应用 ──────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change_this_to_a_random_string
# 生产 CORS 放行的前端 origin（逗号分隔）。dev 留空即可（固定放行 localhost:5173）。
# 裸 IP 部署填前端实际访问地址，注意带端口、不带尾斜杠，如：http://1.2.3.4:5173
CORS_ORIGINS=

# ── 生产前端构建（仅 docker-compose.prod.yml 用，build 时烘焙进 bundle）──────
# 裸 IP 部署时填公网地址；dev 无需设置。
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WS_URL=ws://localhost:8000
